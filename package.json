{
  "name": "resonance-genesis-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/solana"
  ],
  "scripts": {
    "dev": "npm run dev -w @resonance/web",
    "build": "npm run build -w @resonance/web",
    "lint": "npm run lint -w @resonance/web",
    "typecheck": "npm run typecheck -w @resonance/web",
    "forge:build": "forge build --root packages/contracts",
    "forge:test": "forge test --root packages/contracts",
    "deploy:sepolia": "forge script script/DeploySepolia.s.sol:DeploySepolia --root packages/contracts --rpc-url %SEPOLIA_RPC_URL% --private-key %PRIVATE_KEY% --broadcast -vvvv",
    "set:base-uri": "forge script script/SetBaseURI.s.sol:SetBaseURI --root packages/contracts --rpc-url %SEPOLIA_RPC_URL% --private-key %PRIVATE_KEY% --broadcast -vvvv",
    "set:traits": "forge script script/BatchSetTraits.s.sol:BatchSetTraits --root packages/contracts --rpc-url %SEPOLIA_RPC_URL% --private-key %PRIVATE_KEY% --broadcast -vvvv",
    "solana:build": "npm run build -w @resonance/solana",
    "solana:test": "npm run test -w @resonance/solana",
    "solana:deploy:devnet": "npm run deploy:devnet -w @resonance/solana",
    "solana:create-re-token": "npm run create-re-token -w @resonance/solana",
    "solana:create-collection": "npm run create-collection -w @resonance/solana",
    "solana:derive-pdas": "npm run derive-pdas -w @resonance/solana",
    "solana:initialize": "npm run initialize -w @resonance/solana",
    "solana:migrate-global-config": "npm run migrate-global-config -w @resonance/solana",
    "solana:mint-samples": "npm run mint-samples -w @resonance/solana",
    "solana:set-traits": "npm run set-traits -w @resonance/solana",
    "solana:inspect-state": "npm run inspect-state -w @resonance/solana",
    "gen:scientific:v2": "node scripts/generate-scientific-collection-v2.mjs --count 1000",
    "gen:scientific:v3": "node scripts/generate-scientific-collection-v3.mjs --count 1000",
    "gen:scientific:v2:test": "node scripts/generate-scientific-collection-v2.mjs --count 20",
    "gen:scientific:v3:test": "node scripts/generate-scientific-collection-v3.mjs --count 20",
    "svg:png:v2": "node scripts/svg-to-png.mjs --input output_scientific_collection_v2/chladni-nodes/images --output output_scientific_collection_v2/chladni-nodes/png --width 1024 --height 1024",
    "svg:png:v3": "node scripts/svg-to-png.mjs --input output_scientific_collection_v3/chladni-nodes/images --output output_scientific_collection_v3/chladni-nodes/png --width 1024 --height 1024",
    "metadata:update:v2": "node scripts/update-metadata-cid.mjs --metadata-dir output_scientific_collection_v2/chladni-nodes/metadata",
    "metadata:update:v3": "node scripts/update-metadata-cid.mjs --metadata-dir output_scientific_collection_v3/chladni-nodes/metadata",
    "validate:scientific:v2": "node scripts/validate-scientific-output.mjs --dir output_scientific_collection_v2/chladni-nodes",
    "validate:scientific:v3": "node scripts/validate-scientific-output.mjs --dir output_scientific_collection_v3/chladni-nodes --require-colorway"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
